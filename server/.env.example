NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://dinehub:dinehub_dev_only@localhost:5432/dinehub
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
JWT_SECRET=replace-with-32-or-more-random-characters
COOKIE_SECURE=false
# Use none ONLY for HTTPS cross-site API; prefer same-site /api proxy
COOKIE_SAMESITE=lax
# Optional: Sign in with Google
GOOGLE_CLIENT_ID=
# Online payment remains disabled until valid merchant credentials are provided
SSL_ENABLED=false
SSL_STORE_ID=
SSL_STORE_PASSWORD=
SSL_SANDBOX=true
# Store address defaults / shipping fee in BDT
SHIPPING_DHAKA=80
SHIPPING_OUTSIDE=140
# Optional authenticated scheduler to release expired SSL reservations
CRON_SECRET=
# Used only when running db:seed; do not put admin credentials in frontend env
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional authenticated image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional transactional order confirmation emails (requires verified sending domain)
RESEND_API_KEY=
MAIL_FROM=
ADMIN_NOTIFY_EMAIL=
